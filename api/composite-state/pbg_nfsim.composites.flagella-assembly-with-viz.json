{"id": "pbg_nfsim.composites.flagella-assembly-with-viz", "name": "flagella-assembly-with-viz", "description": "NFSim flagella-assembly demo with a wired Visualization Step. Each update produces a Plotly HTML figure of the running species trajectories, written to the 'viz_html' store.", "parameters": {"n_steps": {"type": "integer", "default": 10, "description": "NFSim n_steps per complexation interval."}, "complexation_interval": {"type": "float", "default": 50.0, "description": "Time interval (seconds) between NFSim updates."}, "production_interval": {"type": "float", "default": 1.0, "description": "Time interval (seconds) between MonomerProduction updates."}, "viz_title": {"type": "string", "default": "NFSim flagella assembly", "description": "Title displayed at the top of the Plotly figure."}}, "state": {"production": {"_type": "process", "address": "local:MonomerProduction", "config": {"production_rates": {"Free_fliG": 1.3, "Free_fliM": 1.7, "Free_fliN": 0.05, "Free_flhA": 0.05, "Free_flhB": 0.05}}, "outputs": {"monomers": ["species"]}, "interval": "${production_interval}"}, "complexation": {"_type": "process", "address": "local:NFSimProcess", "config": {"model_file": "<<flagella-model-path>>", "n_steps": "${n_steps}"}, "inputs": {"observables": ["species"]}, "outputs": {"observables": ["species"]}, "interval": "${complexation_interval}"}, "species": {}, "viz_html": "", "viz": {"_type": "step", "address": "local:FlagellaAssemblyPlots", "config": {"title": "${viz_title}"}, "inputs": {"species": ["species"], "time": ["global_time"]}, "outputs": {"html": ["viz_html"]}}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"species": "map[float]", "time": "float"}}, "inputs": {"species": ["species"], "time": ["global_time"]}}}, "schema": {}, "requires": {"processes": ["NFSimProcess", "MonomerProduction", "FlagellaAssemblyPlots", "RAMEmitter"]}, "tags": ["rule-based", "kinetics", "demo", "visualization"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "svg": null, "wiring_status": "ready", "notice": null}