{"id": "pbg_martini.composites.parsimony-whole-cell", "name": "parsimony-whole-cell", "description": "parsimony -> Martini whole-cell MD (PoC). Slices a sub-box of the parsimony-packed v2ecoli structure, assembles Martini CG molecules at the measured positions/orientations (replacing Bentopy random packing), WCA-relaxes, and optionally runs a short OpenMM NVT. Stub CG templates by default so it runs fully offline; supply real martinized templates via the library API for a runnable system.", "parameters": {"pack_path": {"type": "string", "default": "", "description": "Path to the parsimony.pack.v1 JSON (ECOLI_PACK)."}, "out_dir": {"type": "string", "default": "output/parsimony_slice", "description": "Directory for system.gro / system.top / placements.json."}, "stub_beads": {"type": "integer", "default": 5, "description": "Per-species bead count for stub CG templates (offline path)."}, "relax_steps": {"type": "integer", "default": 200, "description": "WCA steepest-descent relaxation steps."}, "md_steps": {"type": "integer", "default": 0, "description": "OpenMM NVT steps (0 = relax only)."}, "run_md": {"type": "boolean", "default": false, "description": "Run the best-effort OpenMM short MD stage."}}, "state": {"slice": {"_type": "step", "address": "local:ParsimonySliceStep", "config": {"pack_path": "${pack_path}", "box_min": [-750.0, -750.0, -750.0], "box_max": [750.0, 750.0, 750.0], "species": ["EG10367-MONOMER", "EG11036-MONOMER", "groel", "EG11384-MONOMER", "EG50003-MONOMER", "EG10669-MONOMER"]}, "inputs": {}, "outputs": {"per_species_counts": ["stores", "slice_counts"], "n_molecules": ["stores", "slice_n_molecules"]}}, "assemble": {"_type": "step", "address": "local:ParsimonyAssembleStep", "config": {"pack_path": "${pack_path}", "box_min": [-750.0, -750.0, -750.0], "box_max": [750.0, 750.0, 750.0], "species": ["EG10367-MONOMER", "EG11036-MONOMER", "groel", "EG11384-MONOMER", "EG50003-MONOMER", "EG10669-MONOMER"], "out_dir": "${out_dir}", "stub_beads": "${stub_beads}", "use_bentopy": true}, "inputs": {}, "outputs": {"gro": ["stores", "gro"], "top": ["stores", "top"], "placements_json": ["stores", "placements_json"], "n_beads": ["stores", "n_beads"], "n_molecules": ["stores", "n_molecules"], "per_species_counts": ["stores", "per_species_counts"]}}, "md": {"_type": "step", "address": "local:MartiniMDStep", "config": {"relax_steps": "${relax_steps}", "md_steps": "${md_steps}", "run_md": "${run_md}"}, "inputs": {"gro": ["stores", "gro"], "top": ["stores", "top"]}, "outputs": {"minimized_gro": ["stores", "minimized_gro"], "final_energy": ["stores", "final_energy"], "md_ran": ["stores", "md_ran"]}}, "stores": {"gro": "", "top": "", "placements_json": "", "minimized_gro": "", "n_beads": 0, "n_molecules": 0, "per_species_counts": {}, "slice_counts": {}, "slice_n_molecules": 0, "final_energy": 0.0, "md_ran": false}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"gro": "string", "n_beads": "integer", "n_molecules": "integer", "final_energy": "float", "md_ran": "boolean"}}, "inputs": {"gro": ["stores", "gro"], "n_beads": ["stores", "n_beads"], "n_molecules": ["stores", "n_molecules"], "final_energy": ["stores", "final_energy"], "md_ran": ["stores", "md_ran"]}}}, "schema": {}, "requires": {"processes": ["ParsimonySliceStep", "ParsimonyAssembleStep", "MartiniMDStep", "RAMEmitter"]}, "tags": ["molecular-dynamics", "coarse-grained", "whole-cell", "parsimony", "martini"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "svg": null, "wiring_status": "ready", "notice": null}